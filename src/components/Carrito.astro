---
/**
 * Carrito y flujo de WhatsApp.
 *
 * Todo lo de esta seccion lleva la clase `solo-js`: si el visitante no tiene
 * JavaScript no ve un boton muerto, ve los links directos a WhatsApp que estan
 * al lado de cada plato.
 *
 * El panel es un <dialog> nativo abierto con showModal(): el navegador ya se
 * ocupa del foco atrapado, del Escape y de dejar inerte el fondo. Escribir eso
 * a mano en JavaScript siempre sale peor.
 *
 * Visualmente es una comanda: renglones, filetes y el total abajo. La logica
 * (src/scripts/carrito.ts) y el armado del mensaje no dependen de este HTML:
 * el script de abajo se engancha por los atributos data-*.
 *
 * Los datos del local los lee el script del navegador directo de negocio.json,
 * asi que aca arriba no hace falta importar nada.
 */
import IconoWhatsApp from './IconoWhatsApp.astro';
---

<!-- Lo que se agrega al pedido se anuncia aca para los lectores de pantalla -->
<p class="sr-only" role="status" aria-live="polite" data-anuncio-pedido></p>

<!-- Barra del pedido: ancha abajo en el celular, pastilla en escritorio -->
<div
  class="solo-js fixed inset-x-0 bottom-0 z-50 hidden sm:inset-x-auto sm:right-6 sm:bottom-6"
  data-fab-contenedor
>
  <button
    type="button"
    class="sup-tinta flex min-h-16 w-full items-center justify-between gap-4 border-t-2 border-crema/20 px-5 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] text-left shadow-[var(--shadow-flota)] transition-transform hover:-translate-y-0.5 sm:min-h-14 sm:w-auto sm:rounded-[var(--radius-control)] sm:border-0 sm:py-2"
    data-abrir-pedido
  >
    <span class="flex items-center gap-3">
      <span
        class="rotulo inline-flex size-8 items-center justify-center rounded-full bg-crema text-[0.9375rem] text-tinta tabular-nums"
        data-fab-cantidad>0</span
      >
      <span class="font-bold [font-stretch:87.5%]">Ver mi pedido</span>
    </span>
    <span class="rotulo text-[0.9375rem] text-papel tabular-nums" data-fab-total></span>
  </button>
</div>

<dialog
  class="panel-pedido solo-js"
  data-panel-pedido
  aria-labelledby="titulo-pedido"
>
  <form class="flex h-full flex-col" data-form-pedido>
    <header class="flex items-center justify-between gap-3 border-b-2 border-tinta px-5 py-4">
      <div>
        <h2 id="titulo-pedido" class="cartel text-titulo-3 leading-none">Tu pedido</h2>
        <p class="rotulo mt-1 text-tinta-suave" data-resumen-items></p>
      </div>
      <button
        type="button"
        class="btn btn-linea btn-icono"
        data-cerrar-pedido
        aria-label="Cerrar el pedido"
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </header>

    <div class="grow overflow-y-auto px-5 pb-6">
      <!-- Vacio -->
      <div class="hidden py-12" data-pedido-vacio>
        <p class="cartel text-titulo-3">Todavía no cargaste nada</p>
        <p class="mt-2 max-w-xs text-tinta-suave">
          Agregá el menú del día o algo de la carta con el botón + y armá el pedido acá.
        </p>
        <button type="button" class="btn btn-linea mt-6" data-cerrar-pedido>
          Volver al menú
        </button>
      </div>

      <!-- Con items -->
      <div class="hidden" data-pedido-lleno>
        <ul class="flex flex-col" data-lista-pedido></ul>

        <div class="mt-6 flex flex-col gap-5">
          <fieldset>
            <legend class="rotulo">¿Cómo lo recibís?</legend>
            <div
              class="mt-2 grid grid-cols-2 overflow-hidden rounded-[var(--radius-control)] border-2 border-tinta"
              role="radiogroup"
            >
              <label
                class="flex min-h-12 cursor-pointer items-center justify-center px-3 text-center font-semibold has-checked:bg-tinta has-checked:text-crema has-focus-visible:outline-3 has-focus-visible:-outline-offset-4 has-focus-visible:outline-ladrillo"
              >
                <input
                  type="radio"
                  name="modalidad"
                  value="delivery"
                  class="sr-only"
                  data-modalidad
                  checked
                />
                Envío a domicilio
              </label>
              <label
                class="flex min-h-12 cursor-pointer items-center justify-center border-l-2 border-tinta px-3 text-center font-semibold has-checked:bg-tinta has-checked:text-crema has-focus-visible:outline-3 has-focus-visible:-outline-offset-4 has-focus-visible:outline-ladrillo"
              >
                <input
                  type="radio"
                  name="modalidad"
                  value="retiro"
                  class="sr-only"
                  data-modalidad
                />
                Retiro en el local
              </label>
            </div>
            <p class="mt-2 text-chico text-tinta-suave" data-aviso-modalidad></p>
          </fieldset>

          <div>
            <label for="pedido-nombre" class="block font-semibold">
              Tu nombre <span class="text-ladrillo" aria-hidden="true">*</span>
            </label>
            <input
              id="pedido-nombre"
              type="text"
              autocomplete="name"
              required
              maxlength="60"
              class="campo mt-1"
              data-campo-nombre
              aria-describedby="error-nombre"
            />
            <p class="mt-1 hidden text-chico font-semibold text-ladrillo" id="error-nombre">
              Poné tu nombre así sabemos de quién es el pedido.
            </p>
          </div>

          <div data-bloque-direccion>
            <label for="pedido-direccion" class="block font-semibold">
              Dirección de entrega <span class="text-ladrillo" aria-hidden="true">*</span>
            </label>
            <input
              id="pedido-direccion"
              type="text"
              autocomplete="street-address"
              maxlength="120"
              class="campo mt-1"
              data-campo-direccion
              aria-describedby="error-direccion ayuda-direccion"
            />
            <p class="mt-1 text-chico text-tinta-suave" id="ayuda-direccion">
              Calle, número y entre qué calles. El delivery llega hasta cierto radio:
              te confirmamos por WhatsApp.
            </p>
            <p class="mt-1 hidden text-chico font-semibold text-ladrillo" id="error-direccion">
              Necesitamos la dirección para llevarte el pedido.
            </p>
          </div>

          <div>
            <label for="pedido-notas" class="block font-semibold">
              Aclaraciones <span class="font-normal text-tinta-suave">(opcional)</span>
            </label>
            <textarea
              id="pedido-notas"
              rows="2"
              maxlength="300"
              class="campo mt-1"
              data-campo-notas
              placeholder="Timbre que no anda, horario, algo que no lleve..."></textarea>
          </div>
        </div>
      </div>
    </div>

    <footer class="sup-papel hidden border-t-2 border-tinta px-5 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))]" data-pie-pedido>
      <div class="aviso-cerrado mb-3 flex items-start gap-3">
        <span class="sello sello-rect shrink-0 text-[1.125rem]" style="--giro: -4deg" aria-hidden="true">Cerrado</span>
        <p class="hidden text-chico" data-aviso-cerrado role="status"></p>
      </div>

      <div class="flex items-baseline justify-between gap-3 border-b-2 border-dotted border-tinta/35 pb-2">
        <span class="rotulo">Total</span>
        <span class="text-titulo-3 font-extrabold tabular-nums [font-stretch:80%]" data-total-pedido></span>
      </div>

      <button type="button" class="btn btn-ladrillo mt-3 w-full" data-enviar-pedido>
        <IconoWhatsApp />
        <span data-texto-enviar>Enviar el pedido por WhatsApp</span>
      </button>

      <div class="mt-1 flex items-center justify-between gap-3">
        <p class="text-chico text-tinta-suave">
          Precios sujetos a cambio: confirmalos al hacer el pedido.
        </p>
        <button
          type="button"
          class="enlace inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center px-1 text-chico font-semibold text-tinta-suave"
          data-vaciar-pedido
        >
          Vaciar
        </button>
      </div>
    </footer>
  </form>
</dialog>

<!-- Molde de cada renglon del pedido: se clona, nunca se arma con innerHTML -->
<template data-molde-item>
  <li class="flex flex-col gap-2 border-b border-tinta/15 py-4">
    <div class="flex items-baseline gap-2">
      <p class="font-semibold" data-nombre></p>
      <span class="guia" aria-hidden="true"></span>
      <p class="rotulo shrink-0 text-[0.9375rem] tabular-nums" data-subtotal></p>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center rounded-[var(--radius-control)] border-2 border-tinta/25">
        <button
          type="button"
          class="flex size-11 items-center justify-center text-xl font-bold text-ladrillo"
          data-menos
        >
          <span aria-hidden="true">−</span>
        </button>
        <input
          type="number"
          min="1"
          max="99"
          step="1"
          inputmode="numeric"
          class="cantidad-pedido h-11 w-12 border-0 bg-transparent text-center font-bold tabular-nums"
          data-cantidad
        />
        <button
          type="button"
          class="flex size-11 items-center justify-center text-xl font-bold text-ladrillo"
          data-mas
        >
          <span aria-hidden="true">+</span>
        </button>
      </div>

      <button
        type="button"
        class="enlace min-h-11 px-1 text-chico font-semibold text-tinta-suave"
        data-quitar
      >
        Quitar
      </button>
    </div>

    <details class="text-chico" data-detalle-aclaracion>
      <summary class="inline-flex min-h-11 cursor-pointer items-center font-semibold text-ladrillo"
        >Agregar una aclaración</summary
      >
      <textarea
        rows="2"
        maxlength="200"
        class="campo mt-1"
        data-aclaracion
        placeholder="Sin sal, bien cocido, cortado al medio..."></textarea>
    </details>
  </li>
</template>

<style is:global>
  /* El sello de CERRADO solo aparece si el local esta cerrado (lo marca
     EstadoApertura en <html>). El texto del aviso lo pone el script. */
  .aviso-cerrado {
    display: none;
  }
  html[data-local-abierto='false'] .aviso-cerrado {
    display: flex;
  }
</style>

<script>
  import * as carrito from '../scripts/carrito';
  import negocio from '../data/negocio.json';
  import { estadoApertura } from '../lib/horarios';
  import { precioPlano } from '../lib/formato';
  import type { HorarioDia, ItemPedido } from '../types';

  const panel = document.querySelector<HTMLDialogElement>('[data-panel-pedido]');
  const molde = document.querySelector<HTMLTemplateElement>('[data-molde-item]');
  const lista = document.querySelector<HTMLUListElement>('[data-lista-pedido]');
  const fab = document.querySelector<HTMLElement>('[data-fab-contenedor]');

  if (panel && molde && lista && fab) {
    const q = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

    const fabCantidad = q('[data-fab-cantidad]');
    const fabTotal = q('[data-fab-total]');
    const resumenItems = q('[data-resumen-items]');
    const vacio = q('[data-pedido-vacio]');
    const lleno = q('[data-pedido-lleno]');
    const pie = q('[data-pie-pedido]');
    const totalPedido = q('[data-total-pedido]');
    const avisoCerrado = q('[data-aviso-cerrado]');
    const avisoModalidad = q('[data-aviso-modalidad]');
    const textoEnviar = q('[data-texto-enviar]');
    const campoNombre = q<HTMLInputElement>('[data-campo-nombre]');
    const campoDireccion = q<HTMLInputElement>('[data-campo-direccion]');
    const campoNotas = q<HTMLTextAreaElement>('[data-campo-notas]');
    const bloqueDireccion = q('[data-bloque-direccion]');
    const errorNombre = q('#error-nombre');
    const errorDireccion = q('#error-direccion');

    /** Quien tenia el foco antes de abrir, para devolverselo al cerrar. */
    let ultimoFoco: HTMLElement | null = null;

    const estadoLocal = () =>
      estadoApertura(negocio.horarios as HorarioDia[], negocio.zonaHoraria);

    /* ------------------------------------------------------------------ */
    /* Pintar                                                             */
    /* ------------------------------------------------------------------ */

    function pintarItem(item: ItemPedido): HTMLLIElement {
      const nodo = molde!.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      const buscar = <T extends HTMLElement>(sel: string) => nodo.querySelector<T>(sel)!;

      buscar('[data-nombre]').textContent = item.nombre;
      buscar('[data-subtotal]').textContent =
        item.precio === null ? 'A confirmar' : precioPlano(item.precio * item.cantidad);

      const cantidad = buscar<HTMLInputElement>('[data-cantidad]');
      cantidad.value = String(item.cantidad);
      cantidad.setAttribute('aria-label', `Cantidad de ${item.nombre}`);

      const menos = buscar<HTMLButtonElement>('[data-menos]');
      const mas = buscar<HTMLButtonElement>('[data-mas]');
      const quitar = buscar<HTMLButtonElement>('[data-quitar]');
      menos.setAttribute('aria-label', `Quitar una unidad de ${item.nombre}`);
      mas.setAttribute('aria-label', `Agregar una unidad de ${item.nombre}`);
      quitar.setAttribute('aria-label', `Sacar ${item.nombre} del pedido`);

      menos.addEventListener('click', () => carrito.sumar(item.id, -1));
      mas.addEventListener('click', () => carrito.sumar(item.id, 1));
      quitar.addEventListener('click', () => carrito.quitar(item.id));
      cantidad.addEventListener('change', () =>
        carrito.establecerCantidad(item.id, Number(cantidad.value)),
      );

      const aclaracion = buscar<HTMLTextAreaElement>('[data-aclaracion]');
      aclaracion.value = item.aclaracion ?? '';
      aclaracion.setAttribute('aria-label', `Aclaración para ${item.nombre}`);
      // Si ya tenia texto, la deja abierta para que se vea.
      if (item.aclaracion) buscar<HTMLDetailsElement>('[data-detalle-aclaracion]').open = true;
      aclaracion.addEventListener('input', () =>
        carrito.ponerAclaracion(item.id, aclaracion.value),
      );

      return nodo;
    }

    function pintar() {
      const estado = carrito.obtener();
      const cantidad = carrito.cantidadTotal();
      const hayItems = cantidad > 0;

      // Boton flotante
      fab!.classList.toggle('hidden', !hayItems);
      document.documentElement.classList.toggle('con-pedido', hayItems);
      fabCantidad.textContent = String(cantidad);
      fabTotal.textContent = carrito.totalTexto();

      // Cuerpo del panel
      vacio.classList.toggle('hidden', hayItems);
      lleno.classList.toggle('hidden', !hayItems);
      pie.classList.toggle('hidden', !hayItems);

      resumenItems.textContent = hayItems
        ? `${cantidad} ${cantidad === 1 ? 'ítem' : 'ítems'}`
        : 'Vacío por ahora';

      // La lista se rearma entera. Se puede porque escribir una aclaracion NO
      // repinta (ver carrito.ts): si repintara, se perderia el cursor.
      lista!.replaceChildren(...estado.items.map(pintarItem));

      totalPedido.textContent = carrito.totalTexto();

      // Modalidad
      for (const radio of document.querySelectorAll<HTMLInputElement>('[data-modalidad]')) {
        radio.checked = radio.value === estado.modalidad;
      }
      const esDelivery = estado.modalidad === 'delivery';
      bloqueDireccion.classList.toggle('hidden', !esDelivery);
      avisoModalidad.textContent = esDelivery
        ? 'Llegamos hasta cierto radio de Punta Alta. Te confirmamos por WhatsApp.'
        : `Lo retirás por ${negocio.direccion.calle}, ${negocio.direccion.localidad}.`;

      if (campoNombre.value !== estado.nombre) campoNombre.value = estado.nombre;
      if (campoDireccion.value !== estado.direccion) campoDireccion.value = estado.direccion;
      if (campoNotas.value !== estado.notas) campoNotas.value = estado.notas;

      // Aviso de local cerrado
      const local = estadoLocal();
      avisoCerrado.classList.toggle('hidden', local.abierto);
      textoEnviar.textContent = local.abierto
        ? 'Enviar el pedido por WhatsApp'
        : 'Enviar igual por WhatsApp';
      if (!local.abierto) {
        avisoCerrado.textContent = `${local.detalle} Podés mandar el pedido igual: te respondemos en el próximo horario de atención.`;
      }
    }

    carrito.suscribir(pintar);

    /* ------------------------------------------------------------------ */
    /* Abrir y cerrar                                                     */
    /* ------------------------------------------------------------------ */

    function abrir() {
      ultimoFoco = document.activeElement as HTMLElement | null;
      panel!.showModal();
      // El foco arranca en el titulo, no en el primer boton.
      panel!.querySelector<HTMLElement>('#titulo-pedido')?.setAttribute('tabindex', '-1');
      panel!.querySelector<HTMLElement>('#titulo-pedido')?.focus();
    }

    function cerrar() {
      panel!.close();
    }

    panel.addEventListener('close', () => ultimoFoco?.focus());

    for (const boton of document.querySelectorAll('[data-abrir-pedido]')) {
      boton.addEventListener('click', abrir);
    }
    for (const boton of document.querySelectorAll('[data-cerrar-pedido]')) {
      boton.addEventListener('click', cerrar);
    }

    // Clic en el fondo oscuro: cierra.
    panel.addEventListener('click', (e) => {
      if (e.target === panel) cerrar();
    });

    /* ------------------------------------------------------------------ */
    /* Botones "Agregar" repartidos por la pagina                         */
    /* ------------------------------------------------------------------ */

    const anuncio = document.querySelector<HTMLElement>('[data-anuncio-pedido]');

    for (const boton of document.querySelectorAll<HTMLButtonElement>('[data-agregar]')) {
      // La confirmacion es un atributo (el CSS cambia el + por un tilde y el
      // color) y, si el boton tiene texto, el texto. No se pisa el contenido
      // entero: los botones de la carta son solo un icono.
      const texto = boton.querySelector<HTMLElement>('[data-texto-boton]');
      // La etiqueta se guarda una sola vez: si se toca varias veces seguidas,
      // no queremos que "Agregado" quede pegado como texto original.
      const etiqueta = texto?.textContent ?? '';
      let reloj: ReturnType<typeof setTimeout> | undefined;

      boton.addEventListener('click', () => {
        const precio = boton.dataset.precio;
        const nombre = boton.dataset.itemNombre!;

        carrito.agregar({
          id: boton.dataset.id!,
          nombre,
          precio: precio ? Number(precio) : null,
          origen: (boton.dataset.origen as ItemPedido['origen']) ?? 'carta',
          aclaracion: '',
        });

        // Confirmacion corta en el mismo boton. No se deshabilita: alguien que
        // quiere tres empanadas tiene que poder tocar tres veces seguidas.
        boton.dataset.agregado = '';
        if (texto) texto.textContent = 'Agregado';
        clearTimeout(reloj);
        reloj = setTimeout(() => {
          delete boton.dataset.agregado;
          if (texto) texto.textContent = etiqueta;
        }, 1200);

        if (anuncio) {
          const n = carrito.cantidadTotal();
          // "Agregamos X" y no "X agregado": los nombres de los platos tienen
          // genero distinto (la milanesa, el pollo) y asi no hay que adivinarlo.
          anuncio.textContent = `Agregamos ${nombre}. Tu pedido tiene ${n} ${
            n === 1 ? 'ítem' : 'ítems'
          }.`;
        }
      });
    }

    /* ------------------------------------------------------------------ */
    /* Campos del formulario                                              */
    /* ------------------------------------------------------------------ */

    campoNombre.addEventListener('input', () => {
      carrito.actualizarCampos({ nombre: campoNombre.value });
      limpiarError(campoNombre, errorNombre);
    });
    campoDireccion.addEventListener('input', () => {
      carrito.actualizarCampos({ direccion: campoDireccion.value });
      limpiarError(campoDireccion, errorDireccion);
    });
    campoNotas.addEventListener('input', () =>
      carrito.actualizarCampos({ notas: campoNotas.value }),
    );

    // Enter dentro del panel no tiene que enviar nada ni cerrarlo.
    q<HTMLFormElement>('[data-form-pedido]').addEventListener('submit', (e) =>
      e.preventDefault(),
    );

    for (const radio of document.querySelectorAll<HTMLInputElement>('[data-modalidad]')) {
      radio.addEventListener('change', () => {
        if (radio.checked) {
          carrito.establecerModalidad(radio.value === 'retiro' ? 'retiro' : 'delivery');
          limpiarError(campoDireccion, errorDireccion);
        }
      });
    }

    q<HTMLButtonElement>('[data-vaciar-pedido]').addEventListener('click', () => {
      carrito.vaciar();
      // El boton "Vaciar" desaparece con el pie del panel: el foco no puede
      // quedar en el aire. Va al titulo, que anuncia "Vacio por ahora".
      q('#titulo-pedido').focus();
    });

    function marcarError(campo: HTMLInputElement, mensaje: HTMLElement) {
      campo.setAttribute('aria-invalid', 'true');
      mensaje.classList.remove('hidden');
    }

    function limpiarError(campo: HTMLInputElement, mensaje: HTMLElement) {
      campo.removeAttribute('aria-invalid');
      mensaje.classList.add('hidden');
    }

    /* ------------------------------------------------------------------ */
    /* Enviar                                                             */
    /* ------------------------------------------------------------------ */

    q<HTMLButtonElement>('[data-enviar-pedido]').addEventListener('click', () => {
      const estado = carrito.obtener();
      if (estado.items.length === 0) return;

      let primerError: HTMLInputElement | null = null;

      if (!estado.nombre.trim()) {
        marcarError(campoNombre, errorNombre);
        primerError = campoNombre;
      } else {
        limpiarError(campoNombre, errorNombre);
      }

      if (estado.modalidad === 'delivery' && !estado.direccion.trim()) {
        marcarError(campoDireccion, errorDireccion);
        primerError = primerError ?? campoDireccion;
      } else {
        limpiarError(campoDireccion, errorDireccion);
      }

      if (primerError) {
        primerError.focus();
        return;
      }

      const local = estadoLocal();
      const url = carrito.linkPedido(negocio.telefono.whatsapp, {
        nombre: negocio.nombre,
        abierto: local.abierto,
        // "Cerrado · abre hoy 11:00" -> "abre hoy 11:00"
        proximoHorario: local.texto.replace(/^Cerrado\s*·\s*/, ''),
      });

      const pestana = window.open(url, '_blank', 'noopener');

      if (pestana) {
        // El pedido queda guardado por si tienen que reenviarlo.
        window.location.href = '/gracias';
      } else {
        // Si el navegador bloqueo la pestana nueva, se abre en la misma.
        window.location.href = url;
      }
    });
  }
</script>
