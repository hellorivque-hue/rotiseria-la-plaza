---
/**
 * Donde estamos: mapa, direccion y contacto.
 *
 * El mapa es el iframe publico de Google Maps buscando por direccion: no
 * necesita API key ni clave de facturacion, y va con loading="lazy" para que
 * no pese en la carga inicial.
 */
import EstadoApertura from './EstadoApertura.astro';
import { negocio, linkWhatsApp, urlMapaEmbed, urlComoLlegar } from '../lib/datos';

/*
  ACA VA LA FOTO DEL FRENTE DEL LOCAL.

  Se sacó a propósito: la única que había era un recorte en blanco y negro de un
  story de Instagram y no representaba bien al local. Queda el mapa, que para
  esta sección es lo que de verdad se necesita.

  Para volver a ponerla cuando llegue la foto buena (apaisada 3:2, 1400x933 o
  más), agregar arriba:

      import { Image } from 'astro:assets';
      import localFoto from '../assets/local.jpg';

  y debajo de la tarjeta de dirección:

      <div class="tarjeta overflow-hidden">
        <Image
          src={localFoto}
          alt={`Frente de ${negocio.nombre} en ${negocio.direccion.calle}`}
          widths={[400, 700]}
          sizes="(min-width: 1024px) 560px, 92vw"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full object-cover"
        />
      </div>
*/

const saludo = `¡Hola ${negocio.nombre}! Quería hacer un pedido.`;
---

<section id="donde-estamos" class="scroll-mt-20 py-12 sm:py-16">
  <div class="contenedor">
    <header class="max-w-2xl">
      <h2 class="titulo-seccion">Dónde estamos</h2>
      <p class="mt-3 text-lg text-tinta-suave">
        Estamos en {negocio.direccion.calle}, en {negocio.direccion.localidad}. Podés
        pasar a retirar o pedir el envío.
      </p>
    </header>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="tarjeta overflow-hidden">
        <iframe
          src={urlMapaEmbed()}
          title={`Mapa con la ubicación de ${negocio.nombre} en ${negocio.direccion.completa}`}
          width="600"
          height="420"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block h-72 w-full border-0 sm:h-[420px]"></iframe>
      </div>

      <div class="flex flex-col gap-5">
        <div class="tarjeta p-5">
          <h3 class="font-display text-lg font-bold">Dirección</h3>
          <address class="mt-2 text-lg not-italic">
            {negocio.direccion.calle}<br />
            {negocio.direccion.localidad} ({negocio.direccion.codigoPostal}), {
              negocio.direccion.provincia
            }
          </address>

          <div class="mt-3">
            <EstadoApertura />
          </div>

          <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href={linkWhatsApp(saludo)}
              target="_blank"
              rel="noopener"
              class="boton boton-primario"
            >
              Pedir por WhatsApp
            </a>
            <a
              href={urlComoLlegar()}
              target="_blank"
              rel="noopener"
              class="boton boton-fantasma"
            >
              Cómo llegar
            </a>
          </div>

          <p class="mt-4">
            <a
              href={`tel:${negocio.telefono.link}`}
              class="inline-flex min-h-11 items-center gap-2 font-display text-xl font-bold text-ladrillo underline underline-offset-4"
            >
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path
                  d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3 6.2 2 2 0 0 1 5 4z"
                ></path>
              </svg>
              {negocio.telefono.visible}
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
