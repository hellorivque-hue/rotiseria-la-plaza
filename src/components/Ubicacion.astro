---
/**
 * Donde estamos: la direccion en grande, el mapa y los datos de contacto.
 *
 * El mapa es el iframe publico de Google Maps buscando por direccion: no
 * necesita API key ni clave de facturacion, y va con loading="lazy" para que
 * no pese en la carga inicial.
 */
import EstadoApertura from './EstadoApertura.astro';
import IconoWhatsApp from './IconoWhatsApp.astro';
import { negocio, linkWhatsApp, urlMapaEmbed, urlComoLlegar } from '../lib/datos';

/*
  ACA VA LA FOTO DEL FRENTE DEL LOCAL.

  Se saco a proposito: la unica que habia era un recorte en blanco y negro de
  un story de Instagram y no representaba bien al local. Queda el mapa, que
  para esta seccion es lo que de verdad se necesita.

  Para volver a ponerla cuando llegue la foto buena (apaisada 3:2, 1400x933 o
  mas, ver public/img/README.md), agregar arriba:

      import { Image } from 'astro:assets';
      import localFoto from '../assets/local.jpg';

  y debajo de los botones de la columna izquierda:

      <Image
        src={localFoto}
        alt={`Frente de ${negocio.nombre} en ${negocio.direccion.calle}`}
        widths={[400, 700]}
        sizes="(min-width: 1024px) 34vw, calc(100vw - 2rem)"
        loading="lazy"
        decoding="async"
        class="foto mt-8 aspect-[3/2] w-full"
      />
*/

const saludo = `¡Hola ${negocio.nombre}! Quería hacer un pedido.`;
---

<section id="donde-estamos" class="sup-papel py-seccion">
  <div class="caja grid gap-x-8 gap-y-8 md:grid-cols-12 md:items-start lg:gap-x-10">
    <div class="md:col-span-5">
      <h2 class="rotulo text-ladrillo">Dónde estamos</h2>
      <address class="mt-2 not-italic">
        <span class="cartel block text-titulo-1">{negocio.direccion.calle}</span>
        <span class="mt-3 block text-lead">
          {negocio.direccion.localidad} ({negocio.direccion.codigoPostal}), {negocio.direccion.provincia}
        </span>
      </address>

      <EstadoApertura class="mt-4" />
      {
        negocio.reputacion && (
          <p class="rotulo mt-2 text-tinta-suave">
            {negocio.reputacion.puntaje.toLocaleString('es-AR')} en {negocio.reputacion.fuente} ·{' '}
            {negocio.reputacion.cantidadOpiniones} opiniones
          </p>
        )
      }

      <div class="mt-6 flex flex-wrap gap-3">
        <a href={urlComoLlegar()} target="_blank" rel="noopener" class="btn btn-ladrillo">
          Cómo llegar
        </a>
        <a href={linkWhatsApp(saludo)} target="_blank" rel="noopener" class="btn btn-linea">
          <IconoWhatsApp />
          Pedir por WhatsApp
        </a>
      </div>

      <p class="mt-6">
        <span class="rotulo block text-tinta-suave">Teléfono y WhatsApp</span>
        <a
          href={`tel:${negocio.telefono.link}`}
          class="enlace inline-flex min-h-11 items-center text-titulo-3 font-extrabold tabular-nums [font-stretch:80%]"
        >
          {negocio.telefono.visible}
        </a>
      </p>
    </div>

    <div class="relative md:col-span-7">
      <!-- Queda debajo del mapa: se ve mientras carga, o si no carga. -->
      <p class="rotulo absolute inset-0 flex items-center justify-center rounded-[var(--radius-foto)] border-2 border-tinta bg-crema text-tinta-suave" aria-hidden="true">
        Cargando el mapa…
      </p>
      <iframe
        src={urlMapaEmbed()}
        title={`Mapa con la ubicación de ${negocio.nombre} en ${negocio.direccion.completa}`}
        width="600"
        height="420"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="relative block aspect-[4/3] h-auto w-full rounded-[var(--radius-foto)] border-2 border-tinta md:aspect-auto md:h-[400px] lg:h-[440px]"
      ></iframe>
    </div>
  </div>
</section>
