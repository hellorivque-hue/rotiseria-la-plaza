---
/**
 * Promos y combos.
 *
 * Si `promos.json` esta vacio, esta seccion no se renderiza: ni el titulo, ni
 * un espacio en blanco, ni un "no hay promociones". Vaciar el archivo (dejarlo
 * en `[]`) es la forma de apagarla.
 *
 * Va sobre tinta: es una franja oscura entre la carta (papel) y lo que sigue,
 * para cortar el ritmo. La destacada ocupa el doble.
 */
import { promos, negocio, linkWhatsApp } from '../lib/datos';
import { precio } from '../lib/formato';

const hayPromos = promos.length > 0;
const ordenadas = [...promos].sort(
  (a, b) => Number(b.destacada ?? false) - Number(a.destacada ?? false),
);
---

{
  hayPromos && (
    <section id="promos" class="sup-tinta py-seccion">
      <div class="caja">
        <header class="border-b-[3px] border-crema pb-3">
          <p class="rotulo text-papel">Conviene</p>
          <h2 class="cartel mt-2 text-titulo-1">Promos y combos</h2>
        </header>

        <ul class="grid gap-x-10 lg:grid-cols-2">
          {ordenadas.map((promo) => (
            <li
              class:list={[
                'flex flex-col gap-3 border-b border-papel/25 py-6',
                promo.destacada && 'lg:col-span-2 lg:grid lg:grid-cols-12 lg:items-end lg:gap-x-10',
              ]}
            >
              <div class:list={[promo.destacada && 'lg:col-span-8']}>
                {promo.etiqueta && <p class="rotulo text-papel">{promo.etiqueta}</p>}
                <h3
                  class:list={[
                    'cartel mt-1',
                    promo.destacada ? 'text-titulo-1' : 'text-titulo-3 lg:text-[2.25rem] lg:leading-none',
                  ]}
                >
                  {promo.titulo}
                </h3>
                <p class="mt-2 max-w-2xl text-papel">{promo.descripcion}</p>
                {promo.condiciones && <p class="mt-1 text-chico text-papel">{promo.condiciones}</p>}
              </div>

              <div
                class:list={[
                  'mt-auto flex flex-wrap items-center gap-x-5 gap-y-3',
                  promo.destacada && 'lg:col-span-4 lg:justify-end',
                ]}
              >
                {promo.precio != null ? (
                  <p class="rotulo text-[1.5rem] tabular-nums">{precio(promo.precio)}</p>
                ) : (
                  <p class="rotulo text-papel">Precio por WhatsApp</p>
                )}
                <button
                  type="button"
                  class="btn btn-crema btn-chico solo-js"
                  data-agregar
                  data-id={`promo-${promo.id}`}
                  data-item-nombre={promo.titulo}
                  data-precio={promo.precio ?? ''}
                  data-origen="promo"
                >
                  <span data-texto-boton>Agregar al pedido</span>
                </button>
                <a
                  href={linkWhatsApp(`¡Hola ${negocio.nombre}! Quería aprovechar la promo: ${promo.titulo}.`)}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-crema btn-chico sin-js"
                >
                  Pedir
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
