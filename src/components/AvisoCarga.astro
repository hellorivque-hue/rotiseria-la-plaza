---
/**
 * Cartel de "sitio en armado".
 *
 * Se muestra mientras `datosEnCarga` este en true en negocio.json.
 * Sirve para que nadie tome por definitivos los precios y los platos que
 * todavia no cargo el local. Para sacarlo: poner `"datosEnCarga": false`.
 */
import { negocio } from '../lib/datos';
---

{
  negocio.datosEnCarga && (
    <div class="sup-tinta">
      <p class="caja py-2 text-chico leading-snug text-papel">
        <strong class="rotulo mr-1 text-crema">Sitio en armado</strong>
        Todavía estamos cargando los platos y los precios. Consultá el menú de hoy por
        WhatsApp.
      </p>
    </div>
  )
}
