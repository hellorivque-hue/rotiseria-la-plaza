---
/**
 * Lockup tipografico del local: "La Plaza" en Sansita.
 *
 * No usamos el logo actual del comercio porque tiene impresa la direccion
 * vieja ("Brown 402"). Cuando manden el logo sin ese bloque, se reemplaza este
 * componente por la imagen. Ver PENDIENTES.md
 */
interface Props {
  /** "chico" para el header, "grande" para el pie. */
  tamano?: 'chico' | 'grande';
  class?: string;
}

const { tamano = 'chico', class: clase = '' } = Astro.props;
---

{
  tamano === 'chico' ? (
    <span class={`cartel text-[1.625rem] leading-none ${clase}`}>La Plaza</span>
  ) : (
    <span class={`flex flex-col ${clase}`}>
      <span class="rotulo">Rotisería</span>
      <span class="cartel text-titulo-1">La Plaza</span>
    </span>
  )
}
