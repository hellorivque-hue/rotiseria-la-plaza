---
/**
 * La semana: el menu de los siete dias, de lunes a domingo, siempre en ese
 * orden. El renglon de hoy se marca con la variante `hoy:` (ver global.css):
 * sin JavaScript despues de cargar y sin reordenar nada.
 *
 * Se edita en src/data/menu-del-dia.json (o desde la planilla, ver PUBLICAR.md).
 */
import Sello from './Sello.astro';
import { menuSemanal, negocio, linkWhatsApp } from '../lib/datos';
import { precio } from '../lib/formato';
import { ORDEN_DIAS } from '../lib/horarios';

const hayMenuCargado = menuSemanal.some((d) => d.principal);

// Se ordenan de lunes a domingo, no como esten en el JSON.
const ordenSemana = [...ORDEN_DIAS.slice(1), ORDEN_DIAS[0]];
const dias = [...menuSemanal].sort(
  (a, b) => ordenSemana.indexOf(a.dia) - ordenSemana.indexOf(b.dia),
);

const cerrados = new Set(negocio.horarios.filter((h) => h.turnos.length === 0).map((h) => h.dia));
---

<section id="menu-del-dia" class="caja grid gap-x-8 pt-36 pb-seccion md:grid-cols-12 md:pt-denso lg:gap-x-10">
  <div class="md:col-span-7">
    <div class="flex items-end justify-between gap-4 border-b-[3px] border-tinta pb-2">
      <h2 class="cartel text-titulo-2">La semana</h2>
      <p class="rotulo pb-1 text-tinta-suave">Cambia todos los días</p>
    </div>

    {
      hayMenuCargado ? (
        <>
          <ul>
            {dias.map((d) => (
              <li
                class="relative grid grid-cols-[3.25rem_1fr_auto] items-center gap-x-3 border-b border-tinta/15 py-3 hoy:bg-papel hoy:before:absolute hoy:before:inset-y-0 hoy:before:-left-gutter hoy:before:w-1.5 hoy:before:bg-ladrillo sm:grid-cols-[6.5rem_1fr_auto]"
                data-dia={d.dia}
              >
                <p class="rotulo text-tinta-suave hoy:text-ladrillo">
                  <span class="sm:hidden">{d.nombre.slice(0, 3)}</span>
                  <span class="hidden sm:inline">{d.nombre}</span>
                  <span class="hidden hoy:block">Hoy</span>
                </p>

                {d.principal ? (
                  <div class="min-w-0">
                    <p class="leading-snug font-semibold">{d.principal}</p>
                    {d.guarnicion && <p class="text-chico text-tinta-suave">con {d.guarnicion}</p>}
                    {(d.destacado || d.precio != null) && (
                      <p class="rotulo mt-1 text-perejil">
                        {[d.destacado, d.precio != null ? precio(d.precio) : null]
                          .filter(Boolean)
                          .join(' · ')}
                      </p>
                    )}
                  </div>
                ) : (
                  <p class="text-tinta-suave">{cerrados.has(d.dia) ? 'Cerrado' : 'A confirmar'}</p>
                )}

                {d.principal ? (
                  <>
                    <button
                      type="button"
                      class="btn-agregar solo-js"
                      aria-label={`Agregar el menú del ${d.nombre.toLowerCase()} al pedido`}
                      data-agregar
                      data-id={`menu-${d.dia}`}
                      data-item-nombre={`Menú del ${d.nombre.toLowerCase()}: ${d.principal}`}
                      data-precio={d.precio ?? ''}
                      data-origen="menu"
                    >
                    </button>
                    <a
                      href={linkWhatsApp(
                        `¡Hola ${negocio.nombre}! Quería pedir el menú del ${d.nombre.toLowerCase()}: ${d.principal}.`,
                      )}
                      target="_blank"
                      rel="noopener"
                      class="enlace sin-js inline-flex min-h-11 items-center font-semibold text-ladrillo"
                    >
                      Pedir
                    </a>
                  </>
                ) : (
                  <span />
                )}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-chico text-tinta-suave">
            Los precios son informativos: te los confirmamos por WhatsApp al hacer el pedido.
          </p>
        </>
      ) : (
        <div class="py-6">
          <p class="text-lead">Todavía no cargamos el menú de esta semana.</p>
          <p class="mt-2 max-w-xl text-tinta-suave">
            Cambia todos los días: escribinos por WhatsApp y te contamos qué hay hoy. Y la carta
            está siempre: milanesas, pastas caseras, tartas, empanadas y pizzas.
          </p>
          <a href="#carta" class="btn btn-linea mt-5">Ver la carta</a>
        </div>
      )
    }
  </div>

  <aside class="hidden md:col-span-5 md:flex md:flex-col md:items-center md:gap-6 md:pt-40 lg:pt-48" aria-label="Cómo trabajamos">
    <Sello class="w-40 lg:w-56" giro={-12} />
    <ul class="rotulo flex flex-col items-center gap-1 text-tinta-suave">
      <li>Pedidos por WhatsApp</li>
      <li>Delivery propio · radio limitado</li>
      <li>Retiro en {negocio.direccion.calle}</li>
    </ul>
  </aside>
</section>
