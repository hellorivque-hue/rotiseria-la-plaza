---
/**
 * Fotos de Instagram.
 *
 * A proposito NO hay scraping ni APIs no oficiales: se rompen solos y van
 * contra los terminos de Instagram. Las fotos se actualizan a mano, cargando
 * las imagenes en src/assets/instagram/ y editando src/data/instagram.json.
 *
 * Diseñado para las fotos que hay (ver public/img/README.md): las de buena
 * resolucion van grandes y las chicas (stories de 640px) nunca pasan de unos
 * 220px. En el celular son una tira que se desliza; en escritorio, un mosaico
 * de dos grandes y cuatro chicas. Si no se da esa combinacion, grilla pareja.
 */
import { Image } from 'astro:assets';
import { instagram, negocio } from '../lib/datos';

// Astro necesita conocer las imagenes en tiempo de build.
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/instagram/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

const posts = instagram
  .map((post) => ({
    ...post,
    fuente: archivos[`../assets/instagram/${post.imagen}`]?.default,
  }))
  .filter((post) => Boolean(post.fuente));

const grandes = posts.filter((p) => p.fuente!.width >= 1000);
const chicas = posts.filter((p) => p.fuente!.width < 1000);
const mosaico = grandes.length === 2 && chicas.length === 4;
// Orden del mosaico: grande, cuatro chicas, grande.
const orden = mosaico ? [grandes[0]!, ...chicas, grandes[1]!] : posts;
---

{
  posts.length > 0 && (
    <section id="instagram" class="py-seccion">
      <header class="caja flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
        <div>
          <p class="rotulo text-ladrillo">Lo que sale del horno</p>
          <h2 class="cartel mt-2 text-titulo-1">En Instagram</h2>
        </div>
        <a
          href={negocio.redes.instagram.url}
          target="_blank"
          rel="noopener me"
          class="btn btn-linea"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" />
          </svg>
          {negocio.redes.instagram.usuario}
        </a>
      </header>

      <ul
        class:list={[
          'caja mt-8 flex snap-x snap-mandatory scroll-px-gutter gap-2 overflow-x-auto pb-2 sin-barra sm:gap-3 lg:grid lg:overflow-visible lg:pb-0',
          // grid-flow-col: la grande ocupa dos columnas y dos filas, las cuatro chicas
          // se acomodan en un cuadrado de 2x2 al lado, y la otra grande cierra.
          mosaico ? 'lg:grid-flow-col lg:grid-cols-6 lg:grid-rows-2' : 'lg:grid-cols-3',
        ]}
      >
        {orden.map((post, i) => {
          const esGrande = mosaico && (i === 0 || i === orden.length - 1);
          return (
            <li
              class:list={[
                'w-[68vw] max-w-72 shrink-0 snap-start sm:w-[40vw] lg:w-auto lg:max-w-none',
                esGrande && 'lg:col-span-2 lg:row-span-2',
              ]}
            >
              <a
                href={post.url ?? negocio.redes.instagram.url}
                target="_blank"
                rel="noopener"
                class="group block overflow-hidden rounded-[var(--radius-foto)] lg:h-full"
              >
                <Image
                  src={post.fuente!}
                  alt={post.alt}
                  widths={esGrande ? [300, 480, 720] : [240, 360, 480]}
                  sizes={esGrande ? '(min-width: 1024px) 31vw, 68vw' : '(min-width: 1024px) 15vw, 68vw'}
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'foto aspect-[4/5] w-full !rounded-none transition-transform duration-300 group-hover:scale-[1.03]',
                    'lg:aspect-square',
                    esGrande && 'lg:h-full',
                  ]}
                />
              </a>
              {post.caption && <p class="mt-2 line-clamp-2 text-chico text-tinta-suave">{post.caption}</p>}
            </li>
          );
        })}
      </ul>
    </section>
  )
}
