---
/**
 * "Por que La Plaza": cuatro razones, dichas como un cartel y no como una
 * grilla de iconitos. Es el bloque con mas aire de la pagina: despues de la
 * carta (que es densa) hace falta respirar.
 *
 * Todas salen de lo que el local comunica de verdad (todo al horno, menu
 * distinto cada dia, delivery propio). Nada de "20 anos de trayectoria" ni
 * premios inventados.
 */
const razones = [
  {
    titulo: 'Todo al horno.',
    texto: 'Es como cocinamos: al horno, no frito. Lo decimos porque es lo que hacemos.',
  },
  {
    titulo: 'Cocina casera.',
    texto: 'Pastas, tartas y milanesas rellenas hechas acá, como en casa.',
  },
  {
    titulo: 'Un menú distinto cada día.',
    texto: 'Nunca comés lo mismo dos veces seguidas. Lo publicamos acá y en Instagram.',
  },
  {
    titulo: 'Delivery propio.',
    texto: 'Te lo llevamos nosotros, sin apps de por medio. El radio es limitado: consultanos.',
  },
];
---

<section id="por-que" class="caja py-aire">
  <h2 class="rotulo text-ladrillo">Por qué La Plaza</h2>
  <ol class="mt-4 border-t-[3px] border-tinta">
    {
      razones.map((r, i) => (
        <li class="grid gap-x-10 gap-y-2 border-b border-tinta/20 py-6 lg:grid-cols-12 lg:items-baseline lg:py-9">
          <p
            class:list={[
              'cartel lg:col-span-7',
              i === 0 ? 'text-titulo-1 text-ladrillo' : 'text-titulo-2',
            ]}
          >
            {r.titulo}
          </p>
          <p class="max-w-xl text-lead text-tinta-suave lg:col-span-5">{r.texto}</p>
        </li>
      ))
    }
  </ol>
</section>
