---
/**
 * Header fijo.
 *
 * El menu de mobile usa <details>/<summary>: se abre y se cierra sin una linea
 * de JavaScript y ya viene con navegacion por teclado del navegador. El JS que
 * hay abajo solo agrega comodidades (cerrarlo al elegir una seccion o con Esc).
 */
import Logo from './Logo.astro';
import EstadoApertura from './EstadoApertura.astro';
import IconoWhatsApp from './IconoWhatsApp.astro';
import { negocio, promos, linkWhatsApp } from '../lib/datos';

// En las paginas de apoyo los anclajes tienen que volver a la home.
const enHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const base = enHome ? '' : '/';

const secciones = [
  { href: `${base}#menu-del-dia`, texto: 'Menú de hoy' },
  { href: `${base}#carta`, texto: 'La carta' },
  ...(promos.length > 0 ? [{ href: `${base}#promos`, texto: 'Promos' }] : []),
  { href: `${base}#delivery`, texto: 'Delivery y horarios' },
  { href: `${base}#donde-estamos`, texto: 'Dónde estamos' },
];

const saludo = `¡Hola ${negocio.nombre}! Quería hacer un pedido.`;
---

<header class="sup-crema sticky top-0 z-40 border-b-2 border-tinta">
  <div class="caja flex h-14 items-center gap-5">
    <a
      href={enHome ? '#inicio' : '/'}
      class="inline-flex min-h-11 shrink-0 items-center text-ladrillo"
      aria-label={`${negocio.nombre}, ir al inicio`}
    >
      <Logo tamano="chico" />
    </a>

    <!-- En el celular el estado va en el hero; aca solo cuando hay lugar. -->
    <div class="hidden lg:block">
      <EstadoApertura />
    </div>

    <!-- Navegacion de escritorio -->
    <nav aria-label="Secciones del sitio" class="ml-auto hidden lg:block">
      <ul class="rotulo flex items-center">
        {
          secciones.map((s) => (
            <li>
              <a
                href={s.href}
                class="inline-flex min-h-11 items-center border-b-[3px] border-transparent px-3 pt-[3px] transition-colors hover:border-ladrillo hover:text-ladrillo"
              >
                {s.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={linkWhatsApp(saludo)}
      target="_blank"
      rel="noopener"
      class="btn btn-ladrillo btn-chico hidden lg:inline-flex"
    >
      <IconoWhatsApp class="size-4" />
      Pedir
    </a>

    <!-- Menu mobile: <details> nativo, anda sin JavaScript -->
    <details class="relative ml-auto lg:hidden" data-menu-mobile>
      <summary
        class="btn btn-linea btn-chico list-none [&::-webkit-details-marker]:hidden"
        aria-label="Abrir el menú de navegación"
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <span>Menú</span>
      </summary>

      <nav
        aria-label="Secciones del sitio"
        class="sup-crema absolute right-0 z-50 mt-2 w-[min(18rem,calc(100vw-2rem))] rounded-[var(--radius-control)] border-2 border-tinta shadow-[var(--shadow-flota)]"
      >
        <EstadoApertura class="border-b border-tinta/15 px-4 py-3 md:hidden" />
        <ul class="flex flex-col py-1">
          {
            secciones.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="flex min-h-12 items-center px-4 font-semibold hover:bg-papel hover:text-ladrillo"
                >
                  {s.texto}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="border-t border-tinta/15 p-3">
          <a
            href={linkWhatsApp(saludo)}
            target="_blank"
            rel="noopener"
            class="btn btn-ladrillo w-full"
          >
            <IconoWhatsApp />
            Pedir por WhatsApp
          </a>
        </div>
      </nav>
    </details>
  </div>
</header>

<script>
  // Comodidades del menu mobile. Sin esto igual abre y cierra.
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu-mobile]');

  if (menu) {
    // Al elegir una seccion, se cierra solo.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });

    // Escape cierra y devuelve el foco al boton.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });

    // Un clic afuera tambien lo cierra.
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
