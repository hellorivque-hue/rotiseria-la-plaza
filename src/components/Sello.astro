---
/**
 * Sello de goma redondo: "TODO AL HORNO · BROWN 406 · PUNTA ALTA".
 *
 * Es el recurso grafico del sitio (ver DISENO.md). Va en pocos lugares: si se
 * pone en todos lados deja de ser un sello y pasa a ser un adorno.
 * Toma el color del texto (currentColor), asi sirve sobre crema y sobre
 * ladrillo. La textura de tinta sale de la clase .sello del CSS global.
 */
import { negocio } from '../lib/datos';

interface Props {
  class?: string;
  /** Giro del sello, en grados. Un sello nunca cae derecho. */
  giro?: number;
}

const { class: clase = '', giro = -8 } = Astro.props;
const anillo = `${negocio.lema} · ${negocio.direccion.calle} · ${negocio.direccion.localidad} · `;
---

<svg
  viewBox="0 0 160 160"
  class={`sello ${clase}`}
  style={`--giro: ${giro}deg`}
  role="img"
  aria-label={`${negocio.lema}. ${negocio.direccion.calle}, ${negocio.direccion.localidad}.`}
>
  <defs>
    <path id="sello-circulo" d="M80,80 m-63,0 a63,63 0 1,1 126,0 a63,63 0 1,1 -126,0"></path>
  </defs>
  <circle cx="80" cy="80" r="76" fill="none" stroke="currentColor" stroke-width="3.5"></circle>
  <circle cx="80" cy="80" r="52" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
  <text
    fill="currentColor"
    style="font-family: var(--font-texto); font-weight: 800; font-stretch: 72%; font-size: 13.5px; letter-spacing: 0.06em; text-transform: uppercase;"
  >
    <textPath href="#sello-circulo" textLength="392" lengthAdjust="spacing">{anillo}</textPath>
  </text>
  <text
    x="80"
    y="73"
    text-anchor="middle"
    fill="currentColor"
    style="font-family: var(--font-texto); font-weight: 800; font-stretch: 70%; font-size: 10px; letter-spacing: 0.16em;"
    >ROTISERÍA</text
  >
  <text
    x="80"
    y="98"
    text-anchor="middle"
    fill="currentColor"
    style="font-family: var(--font-cartel); font-style: italic; font-weight: 900; font-size: 27px;"
    >La Plaza</text
  >
</svg>
