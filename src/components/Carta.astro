---
/**
 * La carta permanente, como una carta impresa: renglones, no tarjetas.
 *
 * Las pestanas de categoria son enlaces de verdad (<a href="#...">): navegan
 * sin recargar, andan sin JavaScript y ya vienen con navegacion por teclado.
 * El JS solo marca la pestana de la seccion que estas mirando.
 *
 * Precios: si TODA la carta esta sin precio (hoy es asi), no se repite
 * "Consultar" 79 veces: va un solo aviso arriba. Apenas se carga un precio,
 * aparece la columna de precios con la linea de puntos, y los que sigan sin
 * precio dicen "Consultar".
 */
import { cartaVisible, negocio, linkWhatsApp } from '../lib/datos';
import { precio } from '../lib/formato';

const hayPrecios = cartaVisible.some((c) => c.items.some((i) => i.precio !== null));
---

<section id="carta" class="sup-papel pt-seccion pb-denso">
  <header class="caja grid gap-x-10 gap-y-3 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="rotulo text-ladrillo">Siempre disponible</p>
      <h2 class="cartel mt-2 text-titulo-1">La carta</h2>
    </div>
    <div class="lg:col-span-5">
      <p class="text-lead">Además del menú del día, esto lo tenemos todos los días.</p>
      {
        !hayPrecios && (
          <p class="rotulo mt-2 text-perejil">Precios por WhatsApp, al hacer el pedido</p>
        )
      }
    </div>
  </header>

  {
    cartaVisible.length === 0 ? (
      <p class="caja mt-8 text-lead">Estamos cargando la carta. Mientras tanto, consultanos por WhatsApp.</p>
    ) : (
      <>
        <nav
          aria-label="Categorías de la carta"
          class="sup-papel sticky top-14 z-30 mt-8 border-y-2 border-tinta"
        >
          <ul class="caja rotulo sin-barra flex overflow-x-auto" data-chips>
            {cartaVisible.map((cat) => (
              <li class="shrink-0">
                <a
                  href={`#cat-${cat.id}`}
                  class="-mb-0.5 inline-flex min-h-12 items-center border-b-[3px] border-transparent px-3 pt-[3px] whitespace-nowrap transition-colors hover:border-tinta/40 aria-[current=true]:border-ladrillo aria-[current=true]:text-ladrillo"
                  data-chip={cat.id}
                >
                  {cat.nombre}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="caja">
          {cartaVisible.map((cat) => (
            <section
              id={`cat-${cat.id}`}
              class="grid gap-x-10 border-b border-tinta/20 py-8 last:border-b-0 lg:grid-cols-12 lg:py-12"
              data-categoria={cat.id}
            >
              <div class="lg:col-span-3">
                <div class="lg:sticky lg:top-36">
                  <h3 class="text-titulo-3 leading-none font-black tracking-wide text-ladrillo uppercase [font-stretch:68%] lg:text-[2rem]">
                    {cat.nombre}
                  </h3>
                  {cat.descripcion && <p class="mt-2 text-chico text-tinta-suave">{cat.descripcion}</p>}
                </div>
              </div>

              <ul class="mt-4 md:columns-2 md:gap-x-8 lg:col-span-9 lg:mt-0 lg:gap-x-10">
                {cat.items.map((item) => (
                  <li class="flex break-inside-avoid items-center gap-3 border-b border-tinta/15 py-3">
                    <div class="min-w-0 grow">
                      {item.recomendado && <p class="rotulo text-ladrillo">Recomendado</p>}
                      {hayPrecios ? (
                        <div class="flex items-end gap-2">
                          <p class="leading-snug font-semibold">{item.nombre}</p>
                          <span class="guia" aria-hidden="true" />
                          <p
                            class:list={[
                              'rotulo shrink-0 tabular-nums',
                              item.precio === null ? 'text-perejil' : 'text-[0.9375rem] text-tinta',
                            ]}
                          >
                            {precio(item.precio)}
                          </p>
                        </div>
                      ) : (
                        <p class="leading-snug font-semibold">{item.nombre}</p>
                      )}
                      {item.descripcion && <p class="text-chico text-tinta-suave">{item.descripcion}</p>}
                      {item.unidad && <p class="text-chico text-tinta-suave">{item.unidad}</p>}
                    </div>

                    <button
                      type="button"
                      class="btn-agregar solo-js"
                      aria-label={`Agregar ${item.nombre} al pedido`}
                      data-agregar
                      data-id={item.id}
                      data-item-nombre={item.nombre}
                      data-precio={item.precio ?? ''}
                      data-origen="carta"
                    >
                    </button>
                    <a
                      href={linkWhatsApp(`¡Hola ${negocio.nombre}! Quería pedir: ${item.nombre}.`)}
                      target="_blank"
                      rel="noopener"
                      class="enlace sin-js inline-flex min-h-11 shrink-0 items-center font-semibold text-ladrillo"
                    >
                      Pedir
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        {hayPrecios && (
          <p class="caja mt-2 text-chico text-tinta-suave">
            Precios sujetos a cambio: confirmalos al hacer el pedido.
          </p>
        )}
      </>
    )
  }
</section>

<script>
  /**
   * Marca la pestana de la categoria que se esta viendo y la deja a la vista
   * dentro de la barra horizontal. Es solo una ayuda visual: si esto no corre,
   * las pestanas siguen funcionando como enlaces.
   */
  const chips = new Map<string, HTMLAnchorElement>();
  for (const chip of document.querySelectorAll<HTMLAnchorElement>('[data-chip]')) {
    chips.set(chip.dataset.chip!, chip);
  }

  const secciones = document.querySelectorAll<HTMLElement>('[data-categoria]');

  if (chips.size > 0 && secciones.length > 0) {
    let activo = '';

    const marcar = (id: string) => {
      if (id === activo) return;
      activo = id;

      for (const [clave, chip] of chips) {
        const esActivo = clave === id;
        chip.setAttribute('aria-current', String(esActivo));
        if (esActivo) acomodarBarra(chip);
      }
    };

    /**
     * Desplaza SOLO la barra de pestanas, nunca la pagina.
     * (scrollIntoView moveria el scroll vertical y haria saltar el sitio.)
     */
    const barra = document.querySelector<HTMLElement>('[data-chips]');

    const acomodarBarra = (chip: HTMLAnchorElement) => {
      if (!barra) return;
      const objetivo =
        chip.offsetLeft - barra.clientWidth / 2 + chip.offsetWidth / 2;
      const maximo = barra.scrollWidth - barra.clientWidth;
      if (maximo <= 0) return;
      barra.scrollTo({
        left: Math.max(0, Math.min(objetivo, maximo)),
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth',
      });
    };

    // Respuesta inmediata al tocar una pestana, sin esperar al scroll.
    for (const [clave, chip] of chips) {
      chip.addEventListener('click', () => marcar(clave));
    }

    // Arranca con la primera categoria marcada para que la barra nunca se vea
    // "apagada" antes del primer scroll.
    marcar([...chips.keys()][0]!);

    const observador = new IntersectionObserver(
      (entradas) => {
        const visibles = entradas
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        const primera = visibles[0]?.target as HTMLElement | undefined;
        if (primera?.dataset.categoria) marcar(primera.dataset.categoria);
      },
      // La franja de arriba, justo debajo del header y de las pestanas.
      { rootMargin: '-140px 0px -55% 0px', threshold: 0 },
    );

    for (const seccion of secciones) observador.observe(seccion);
  }
</script>
