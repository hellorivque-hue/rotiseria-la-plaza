---
/**
 * Delivery y horarios. Franja oscura y densa: datos, no adornos.
 *
 * Los horarios salen de negocio.json, no estan escritos a mano: si cambian,
 * se cambian en un solo lugar y se actualizan aca, en el pie y en el JSON-LD.
 * La fila de hoy se marca con la variante `hoy:` (ver global.css).
 */
import EstadoApertura from './EstadoApertura.astro';
import IconoWhatsApp from './IconoWhatsApp.astro';
import { negocio, linkWhatsApp } from '../lib/datos';

const consultaZona = `¡Hola ${negocio.nombre}! ¿Llegan con el delivery a mi barrio? Mi dirección es: `;
const hayZonas = negocio.delivery.zonas.length > 0;
---

<section id="delivery" class="sup-tinta py-seccion">
  <div class="caja grid gap-x-8 gap-y-12 md:grid-cols-12 lg:gap-x-10">
    <div class="md:col-span-6">
      <h2 class="cartel text-titulo-1">Delivery y horarios</h2>
      <p class="mt-5 max-w-xl text-lead text-papel">{negocio.delivery.descripcion}</p>

      {
        hayZonas && (
          <div class="mt-6">
            <h3 class="rotulo text-papel">Zonas confirmadas</h3>
            <p class="mt-1">{negocio.delivery.zonas.join(' · ')}</p>
          </div>
        )
      }

      <div class="mt-8 border-t-2 border-papel/40 pt-6">
        <h3 class="subtitulo">¿Llegamos a tu barrio?</h3>
        <p class="mt-2 max-w-xl text-papel">
          Mandanos tu dirección por WhatsApp y te confirmamos al toque. También podés
          retirar el pedido por {negocio.direccion.calle}.
        </p>
        <a
          href={linkWhatsApp(consultaZona)}
          target="_blank"
          rel="noopener"
          class="btn btn-crema mt-5"
        >
          <IconoWhatsApp />
          Consultar mi zona
        </a>
        <p class="mt-3 text-chico text-papel">
          {
            negocio.delivery.costoEnvio
              ? `Costo de envío: ${negocio.delivery.costoEnvio}.`
              : 'El costo del envío te lo confirmamos por WhatsApp junto con el pedido.'
          }
        </p>
      </div>
    </div>

    <div class="md:col-span-6 lg:col-span-5 lg:col-start-8">
      <div class="flex flex-wrap items-baseline justify-between gap-3 border-b-[3px] border-crema pb-2">
        <h3 class="subtitulo">Horarios</h3>
        <EstadoApertura sobre="oscuro" />
      </div>

      <table class="w-full text-left">
        <caption class="sr-only">
          Horarios de atención de {negocio.nombre}, de lunes a domingo
        </caption>
        <thead class="sr-only">
          <tr>
            <th scope="col">Día</th>
            <th scope="col">Horario</th>
          </tr>
        </thead>
        <tbody>
          {
            negocio.horarios.map((dia) => (
              <tr class="border-b border-papel/20 hoy:bg-crema hoy:text-tinta" data-dia={dia.dia}>
                <th scope="row" class="py-3 pr-3 pl-2 text-left font-semibold whitespace-nowrap">
                  {dia.nombre}
                  <span class="rotulo ml-2 hidden text-ladrillo hoy:inline">Hoy</span>
                </th>
                <td class="py-3 pr-2 pl-3 text-right tabular-nums">
                  {dia.turnos.length === 0 ? (
                    <span class="text-papel hoy:text-tinta-suave">Cerrado</span>
                  ) : (
                    dia.turnos.map((t) => `${t.desde}–${t.hasta}`).join(' · ')
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <p class="mt-4 text-chico text-papel">
        Los pedidos que entran fuera de horario los respondemos cuando abrimos.
      </p>
    </div>
  </div>
</section>
