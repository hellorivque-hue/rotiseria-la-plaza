---
/**
 * Hero: en 5 segundos tiene que quedar claro que es el lugar, si esta abierto
 * y como se pide. Nada mas.
 */
import { Image } from 'astro:assets';
import EstadoApertura from './EstadoApertura.astro';
import heroPlato from '../assets/hero-plato.jpg';
import { negocio, linkWhatsApp } from '../lib/datos';

const saludo = `¡Hola ${negocio.nombre}! Quería hacer un pedido.`;
const reputacion = negocio.reputacion;
---

<section id="inicio" class="relative overflow-hidden bg-ladrillo text-crema">
  <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
    <div
      class="size-full"
      style="background-image: radial-gradient(circle at 1px 1px, #fff 1.5px, transparent 0); background-size: 26px 26px;"
    >
    </div>
  </div>

  <div
    class="contenedor relative grid items-center gap-6 py-8 sm:gap-8 sm:py-14 lg:grid-cols-[1.15fr_1fr] lg:gap-14 lg:py-20"
  >
    <div>
      <p
        class="font-sans text-sm font-bold tracking-[0.28em] text-mostaza uppercase sm:text-base"
      >
        {negocio.lema}
      </p>

      <h1 class="mt-2 font-display text-[2.6rem] leading-[1.05] font-extrabold sm:text-6xl">
        Rotisería <span class="text-mostaza">La Plaza</span>
      </h1>

      <p class="mt-3 max-w-lg text-lg leading-relaxed text-crema/90 sm:mt-4 sm:text-xl">
        Comida casera hecha al horno, con un menú distinto cada día. Delivery
        propio en Punta Alta y retiro en Brown 406.
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-2 sm:gap-3">
        <EstadoApertura sobre="oscuro" />
        {
          reputacion && (
            <p class="inline-flex items-center gap-1.5 rounded-full border border-white/25 bg-black/25 px-3 py-1.5 text-sm">
              <span aria-hidden="true" class="text-mostaza">
                ★
              </span>
              <span>
                {reputacion.puntaje.toLocaleString('es-AR')} en {reputacion.fuente}
                <span class="text-crema/70">
                  {' '}
                  ({reputacion.cantidadOpiniones} opiniones)
                </span>
              </span>
            </p>
          )
        }
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={linkWhatsApp(saludo)}
          target="_blank"
          rel="noopener"
          class="boton boton-primario w-full sm:w-auto"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12.04 2C6.6 2 2.17 6.43 2.17 11.87c0 1.74.46 3.44 1.32 4.94L2 22l5.35-1.4a9.83 9.83 0 0 0 4.69 1.19h.01c5.44 0 9.87-4.43 9.87-9.87S17.48 2 12.04 2Zm5.43 12.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"
            ></path>
          </svg>
          Pedir por WhatsApp
        </a>

        <a
          href="#menu-del-dia"
          class="boton w-full border-2 border-crema/40 text-crema hover:bg-white/10 sm:w-auto"
        >
          Ver el menú de hoy
        </a>
      </div>

      <p class="mt-3 text-sm text-crema/70">
        {/*
          Solo se baja la primera letra. Con toLowerCase() entero quedaba
          "...22:30. domingos cerrado", con la D minuscula despues del punto.
        */}
        Atendemos {negocio.horariosTexto.charAt(0).toLowerCase() +
          negocio.horariosTexto.slice(1)}
      </p>
    </div>

    <div class="relative">
      <Image
        src={heroPlato}
        alt="Milanesa de ternera con fideos, servida en un plato de Rotisería La Plaza"
        widths={[400, 600, 900]}
        sizes="(min-width: 1024px) 460px, 92vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[2/1] w-full rounded-2xl border-4 border-crema/20 object-cover shadow-[var(--shadow-flotante)] sm:aspect-[16/9] lg:aspect-square"
      />
    </div>
  </div>
</section>
