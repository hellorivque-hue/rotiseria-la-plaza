---
/**
 * Hero: el plato de hoy, en grande. Es lo primero y lo mas grande del sitio.
 *
 * El sitio es estatico: el build no sabe que dia va a ser cuando alguien
 * entre. Por eso se renderiza un panel por cada dia que tiene menu cargado, y
 * el CSS muestra el de hoy usando el data-hoy que el <head> pone en <html>
 * (ver Base.astro). No hay JavaScript despues de cargar y nada se mueve.
 *
 * Tres estados:
 *   - hoy hay menu cargado ........ el plato, con HOY sellado
 *   - hoy no hay menu cargado ..... "¿Que hay hoy?" y preguntar por WhatsApp
 *   - hoy el local no abre ........ "Hoy descansamos" (domingo)
 * Sin JavaScript se ve el segundo, y abajo la semana completa.
 */
import { Image } from 'astro:assets';
import EstadoApertura from './EstadoApertura.astro';
import IconoWhatsApp from './IconoWhatsApp.astro';
import heroPlato from '../assets/hero-plato.jpg';
import { menuSemanal, negocio, linkWhatsApp } from '../lib/datos';
import { precio } from '../lib/formato';

const conMenu = menuSemanal.filter((d) => d.principal);
const preguntar = linkWhatsApp(`¡Hola ${negocio.nombre}! ¿Qué menú hay hoy?`);
// "Lunes a sábado de..." -> "lunes a sábado de...", para que siga a "Atendemos".
const horarios = negocio.horariosTexto.charAt(0).toLowerCase() + negocio.horariosTexto.slice(1);
const dejarPedido = linkWhatsApp(`¡Hola ${negocio.nombre}! Quería dejar un pedido para cuando abran.`);
---

<section id="inicio" class="sup-ladrillo">
  <div class="caja grid gap-x-8 pt-6 md:grid-cols-12 md:pt-10 lg:gap-x-10 lg:pt-14">
    <div class="md:col-span-7 md:pb-16 lg:pb-20">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
        <h1 class="rotulo text-papel">{negocio.nombre} · {negocio.direccion.localidad}</h1>
        <div class="lg:hidden">
          <EstadoApertura sobre="oscuro" />
        </div>
      </div>

      {
        conMenu.map((d) => (
          <div class="hero-dia" data-dia={d.dia}>
            <div class="mt-5 flex items-center gap-4 lg:mt-8">
              <span class="sello sello-rect text-[1.875rem] text-crema lg:text-[2.75rem]">Hoy</span>
              <p class="rotulo text-papel">
                Menú del {d.nombre.toLowerCase()}
                {d.destacado && <span class="block text-crema">{d.destacado}</span>}
              </p>
            </div>

            <p class:list={['cartel mt-4 lg:mt-6', d.principal!.length > 22 ? 'text-cartel-largo' : 'text-cartel']}>
              {d.principal}
            </p>
            {d.guarnicion && <p class="mt-4 text-lead text-papel lg:mt-7">con {d.guarnicion}</p>}

            <div class="mt-6 flex flex-wrap items-center gap-3 lg:mt-10">
              <button
                type="button"
                class="btn btn-crema solo-js grow sm:grow-0"
                data-agregar
                data-abrir-pedido
                data-id={`menu-${d.dia}`}
                data-item-nombre={`Menú del ${d.nombre.toLowerCase()}: ${d.principal}`}
                data-precio={d.precio ?? ''}
                data-origen="menu"
              >
                <span data-texto-boton>Pedir este menú</span>
              </button>
              <a
                href={linkWhatsApp(
                  `¡Hola ${negocio.nombre}! Quería pedir el menú del ${d.nombre.toLowerCase()}: ${d.principal}.`,
                )}
                target="_blank"
                rel="noopener"
                class="btn btn-crema sin-js grow sm:grow-0"
              >
                <IconoWhatsApp />
                Pedir este menú
              </a>
              <a href="#menu-del-dia" class="btn btn-linea shrink-0">La semana</a>
              {d.precio != null && (
                <p class="rotulo text-[1.75rem] tabular-nums sm:ml-2">{precio(d.precio)}</p>
              )}
            </div>
            <p class="mt-3 text-chico text-papel">
              {d.precio == null
                ? 'Precio y envío te los confirmamos por WhatsApp.'
                : 'Precio informativo: te lo confirmamos por WhatsApp junto con el envío.'}
            </p>
          </div>
        ))
      }

      <div class="hero-generico">
        <p class="rotulo mt-5 text-papel lg:mt-8">Menú del día</p>
        <p class="cartel mt-3 text-cartel lg:mt-5">¿Qué hay hoy?</p>
        <p class="mt-3 max-w-xl text-lead text-papel lg:mt-5">
          El menú cambia todos los días y siempre es al horno. Escribinos y te contamos.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 lg:mt-10">
          <a href={preguntar} target="_blank" rel="noopener" class="btn btn-crema grow sm:grow-0">
            <IconoWhatsApp />
            Preguntar qué hay
          </a>
          <a href="#carta" class="btn btn-linea shrink-0">La carta</a>
        </div>
      </div>

      <div class="hero-cerrado">
        <div class="mt-5 flex items-center gap-4 lg:mt-8">
          <span class="sello sello-rect text-[1.5rem] text-crema lg:text-[2.25rem]" style="--giro: 4deg">Cerrado</span>
          <p class="rotulo text-papel">Hoy no abrimos</p>
        </div>
        <p class="cartel mt-4 text-cartel lg:mt-6">Hoy descansamos</p>
        <p class="mt-3 max-w-xl text-lead text-papel lg:mt-5">
          Atendemos {horarios} Si nos dejás el pedido por WhatsApp, te respondemos cuando abrimos.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 lg:mt-10">
          <a href={dejarPedido} target="_blank" rel="noopener" class="btn btn-crema grow sm:grow-0">
            <IconoWhatsApp />
            Dejar un pedido
          </a>
          <a href="#carta" class="btn btn-linea shrink-0">La carta</a>
        </div>
      </div>
    </div>

    <figure class="relative z-10 mt-8 -mb-24 self-start md:col-span-5 md:mt-0 md:mb-0 md:translate-y-20 lg:translate-y-28">
      <Image
        src={heroPlato}
        alt="Milanesa de ternera con fideos, servida en un plato de Rotisería La Plaza"
        widths={[400, 640, 900, 1200]}
        sizes="(min-width: 1408px) 536px, (min-width: 768px) 38vw, calc(100vw - 2rem)"
        loading="eager"
        fetchpriority="high"
        class="foto aspect-[4/3] w-full object-[45%_40%] md:aspect-[4/5]"
      />
      <!-- La foto es siempre la misma: que no parezca el plato de hoy. Va como
           etiqueta encima de la foto para leerse igual sobre rojo o sobre crema. -->
      <figcaption class="rotulo absolute bottom-2 left-2 rounded-[var(--radius-sello)] bg-crema px-2 py-1 text-tinta">
        De nuestra cocina
      </figcaption>
    </figure>
  </div>
</section>

<style is:global>
  /* Que panel se ve. Ver el comentario de arriba y el script de Base.astro. */
  .hero-dia,
  .hero-cerrado {
    display: none;
  }
  html[data-hoy='lunes'] .hero-dia[data-dia='lunes'],
  html[data-hoy='martes'] .hero-dia[data-dia='martes'],
  html[data-hoy='miercoles'] .hero-dia[data-dia='miercoles'],
  html[data-hoy='jueves'] .hero-dia[data-dia='jueves'],
  html[data-hoy='viernes'] .hero-dia[data-dia='viernes'],
  html[data-hoy='sabado'] .hero-dia[data-dia='sabado'],
  html[data-hoy='domingo'] .hero-dia[data-dia='domingo'],
  html[data-hoy-cerrado='true'] .hero-cerrado {
    display: block;
  }
  html[data-hoy-con-menu='true'] .hero-generico,
  html[data-hoy-cerrado='true'] .hero-generico,
  html[data-hoy-cerrado='true'] .hero-dia {
    display: none;
  }
</style>
