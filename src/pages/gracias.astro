---
/**
 * Pagina de "gracias": se llega despues de mandar el pedido por WhatsApp.
 *
 * Ojo: el pedido NO se borra solo. Si WhatsApp no se abrio, o la persona
 * cambio algo, tiene que poder volver y reenviarlo. Se borra apretando el
 * boton de abajo.
 */
import Base from '../layouts/Base.astro';
import { negocio, linkWhatsApp, urlComoLlegar } from '../lib/datos';
import EstadoApertura from '../components/EstadoApertura.astro';
---

<Base
  titulo={`¡Gracias por tu pedido! · ${negocio.nombre}`}
  descripcion="Recibimos tu pedido. Te confirmamos por WhatsApp."
  noIndexar
>
  <section class="contenedor py-14 sm:py-20">
    <div class="mx-auto max-w-xl text-center">
      <p
        class="mx-auto flex size-16 items-center justify-center rounded-full bg-verde-abierto/15 text-3xl"
        aria-hidden="true"
      >
        🧑‍🍳
      </p>

      <h1 class="titulo-seccion mt-5">¡Gracias! Ya casi</h1>

      <p class="mt-4 text-lg text-tinta-suave">
        Se te abrió WhatsApp con el pedido escrito. <strong class="text-tinta"
          >Falta que toques enviar</strong
        > en la conversación para que nos llegue.
      </p>

      <div class="mt-6 flex justify-center">
        <EstadoApertura />
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href={linkWhatsApp(`¡Hola ${negocio.nombre}! Quería hacer un pedido.`)}
          target="_blank"
          rel="noopener"
          class="boton boton-primario"
        >
          Volver a abrir WhatsApp
        </a>
        <a href="/" class="boton boton-fantasma">Volver al menú</a>
      </div>

      <div class="tarjeta mt-10 p-6 text-left">
        <h2 class="font-display text-lg font-bold">Mientras tanto</h2>
        <ul class="mt-3 flex flex-col gap-2 text-tinta-suave">
          <li>
            Si pediste envío, te confirmamos por WhatsApp si llegamos a tu zona: el
            delivery tiene un radio limitado.
          </li>
          <li>
            Si preferís retirarlo, estamos en
            <a
              href={urlComoLlegar()}
              target="_blank"
              rel="noopener"
              class="font-medium text-ladrillo underline underline-offset-4"
              >{negocio.direccion.calle}, {negocio.direccion.localidad}</a
            >.
          </li>
          <li>
            Cualquier cosa, llamanos al
            <a
              href={`tel:${negocio.telefono.link}`}
              class="font-medium text-ladrillo underline underline-offset-4"
              >{negocio.telefono.visible}</a
            >.
          </li>
        </ul>

        <button
          type="button"
          class="boton boton-fantasma solo-js mt-6 w-full"
          data-empezar-de-nuevo
        >
          Empezar un pedido nuevo
        </button>
        <p class="mt-2 text-sm text-tinta-suave" data-aviso-vaciado hidden>
          Listo, vaciamos el pedido.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { vaciar } from '../scripts/carrito';

  const boton = document.querySelector<HTMLButtonElement>('[data-empezar-de-nuevo]');
  const aviso = document.querySelector<HTMLElement>('[data-aviso-vaciado]');

  boton?.addEventListener('click', () => {
    vaciar();
    boton.disabled = true;
    boton.textContent = 'Pedido vaciado';
    aviso?.removeAttribute('hidden');
  });
</script>
