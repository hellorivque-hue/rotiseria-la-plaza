---
/**
 * Pagina de "gracias": se llega despues de mandar el pedido por WhatsApp.
 *
 * Ojo: el pedido NO se borra solo. Si WhatsApp no se abrio, o la persona
 * cambio algo, tiene que poder volver y reenviarlo. Se borra apretando el
 * boton de abajo.
 */
import Base from '../layouts/Base.astro';
import IconoWhatsApp from '../components/IconoWhatsApp.astro';
import EstadoApertura from '../components/EstadoApertura.astro';
import { negocio, linkWhatsApp, urlComoLlegar } from '../lib/datos';
---

<Base
  titulo={`¡Gracias por tu pedido! · ${negocio.nombre}`}
  descripcion="Recibimos tu pedido. Te confirmamos por WhatsApp."
  noIndexar
>
  <section class="sup-ladrillo">
    <div class="caja py-seccion">
      <p class="rotulo text-papel">Pedido armado</p>
      <h1 class="cartel mt-3 text-titulo-1">¡Gracias! Ya casi.</h1>
      <p class="mt-5 max-w-2xl text-lead">
        Se te abrió WhatsApp con el pedido escrito. <strong>Falta que toques enviar</strong> en la
        conversación para que nos llegue.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={linkWhatsApp(`¡Hola ${negocio.nombre}! Quería hacer un pedido.`)}
          target="_blank"
          rel="noopener"
          class="btn btn-crema"
        >
          <IconoWhatsApp />
          Volver a abrir WhatsApp
        </a>
        <a href="/" class="btn btn-linea">Volver al menú</a>
      </div>
    </div>
  </section>

  <section class="caja grid gap-x-10 gap-y-8 py-seccion lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2 class="subtitulo">Mientras tanto</h2>
      <ul class="mt-4 border-t-2 border-tinta">
        <li class="border-b border-tinta/15 py-4">
          Si pediste envío, te confirmamos por WhatsApp si llegamos a tu zona: el delivery
          tiene un radio limitado.
        </li>
        <li class="border-b border-tinta/15 py-4">
          Si preferís retirarlo, estamos en
          <a href={urlComoLlegar()} target="_blank" rel="noopener" class="enlace font-semibold"
            >{negocio.direccion.calle}, {negocio.direccion.localidad}</a
          >.
        </li>
        <li class="border-b border-tinta/15 py-4">
          Cualquier cosa, llamanos al
          <a href={`tel:${negocio.telefono.link}`} class="enlace font-semibold tabular-nums"
            >{negocio.telefono.visible}</a
          >.
        </li>
      </ul>
    </div>

    <div class="lg:col-span-4 lg:col-start-9">
      <EstadoApertura />
      <p class="mt-4 text-tinta-suave">
        Tu pedido sigue guardado en este teléfono por si hay que reenviarlo. Si ya está todo
        bien, podés empezar uno nuevo.
      </p>
      <button type="button" class="btn btn-linea solo-js mt-5 w-full" data-empezar-de-nuevo>
        Empezar un pedido nuevo
      </button>
      <p class="mt-2 text-chico font-semibold text-perejil" data-aviso-vaciado hidden>
        Listo, vaciamos el pedido.
      </p>
    </div>
  </section>
</Base>

<script>
  import { vaciar } from '../scripts/carrito';

  const boton = document.querySelector<HTMLButtonElement>('[data-empezar-de-nuevo]');
  const aviso = document.querySelector<HTMLElement>('[data-aviso-vaciado]');

  boton?.addEventListener('click', () => {
    vaciar();
    boton.disabled = true;
    boton.textContent = 'Pedido vaciado';
    aviso?.removeAttribute('hidden');
  });
</script>
