---
/**
 * Layout base de todas las paginas.
 *
 * Se ocupa del <head> (SEO, Open Graph, fuentes), del salto de accesibilidad,
 * del header y del footer. El contenido va en el <slot />.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AvisoCarga from '../components/AvisoCarga.astro';
import Carrito from '../components/Carrito.astro';
import { negocio } from '../lib/datos';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta de la imagen para compartir, dentro de /public. */
  imagenOg?: string;
  /** Las paginas de apoyo (gracias, 404) no van al buscador. */
  noIndexar?: boolean;
  /** El carrito solo hace falta donde se puede pedir (la home). */
  conCarrito?: boolean;
}

const {
  titulo,
  descripcion,
  imagenOg = '/img/og.jpg',
  noIndexar = false,
  conCarrito = false,
} = Astro.props;

const canonica = new URL(Astro.url.pathname, Astro.site ?? 'https://rotiserialaplaza.com.ar');
const urlOg = new URL(imagenOg, Astro.site ?? 'https://rotiserialaplaza.com.ar');
---

<!doctype html>
<html lang="es-AR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica.href} />
    {noIndexar && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content="#a21b12" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph: lo que se ve cuando comparten el link por WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica.href} />
    <meta property="og:image" content={urlOg.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Las dos fuentes se usan arriba de todo, conviene precargarlas -->
    <link
      rel="preload"
      href="/fonts/bitter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/og.jpg" />

    <slot name="head" />

    <!--
      Marca que hay JavaScript. Todo lo que no funciona sin JS (solo el carrito)
      esta oculto hasta que esta linea corre. Va inline y arriba para que no
      haya parpadeo.
    -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="min-h-dvh bg-crema text-tinta antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ladrillo focus:px-5 focus:py-3 focus:font-semibold focus:text-white focus:shadow-lg"
      >Saltar al contenido</a
    >

    <AvisoCarga />
    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />

    {conCarrito && <Carrito />}
  </body>
</html>
