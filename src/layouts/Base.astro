---
/**
 * Layout base de todas las paginas.
 *
 * Se ocupa del <head> (SEO, Open Graph, fuentes), del salto de accesibilidad,
 * del header y del footer. El contenido va en el <slot />.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AvisoCarga from '../components/AvisoCarga.astro';
import Carrito from '../components/Carrito.astro';
import { negocio, menuSemanal } from '../lib/datos';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta de la imagen para compartir, dentro de /public. */
  imagenOg?: string;
  /** Las paginas de apoyo (gracias, 404) no van al buscador. */
  noIndexar?: boolean;
  /** El carrito solo hace falta donde se puede pedir (la home). */
  conCarrito?: boolean;
}

const {
  titulo,
  descripcion,
  imagenOg = '/img/og.jpg',
  noIndexar = false,
  conCarrito = false,
} = Astro.props;

const canonica = new URL(Astro.url.pathname, Astro.site ?? 'https://rotiserialaplaza.com.ar');
const urlOg = new URL(imagenOg, Astro.site ?? 'https://rotiserialaplaza.com.ar');

/*
  Lo que el script de "hoy" necesita saber, resuelto en el build: que dias
  tienen menu cargado y que dias el local no abre.
*/
const hoyDatos = JSON.stringify({
  zona: negocio.zonaHoraria,
  conMenu: menuSemanal.filter((d) => d.principal).map((d) => d.dia),
  cerrados: negocio.horarios.filter((h) => h.turnos.length === 0).map((h) => h.dia),
});
---

<!doctype html>
<html lang="es-AR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica.href} />
    {noIndexar && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content="#a21b12" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph: lo que se ve cuando comparten el link por WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica.href} />
    <meta property="og:image" content={urlOg.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Las dos fuentes se usan en la primera pantalla: se precargan. -->
    <link
      rel="preload"
      href="/fonts/archivo-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/sansita-black-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/og.jpg" />

    <slot name="head" />

    <!--
      Corre antes de pintar nada, por eso va inline y en el <head>:
      1. Marca que hay JavaScript (lo del carrito esta oculto hasta aca).
      2. Pone en <html> que dia es hoy EN PUNTA ALTA, si hay menu cargado para
         hoy y si hoy el local no abre. El CSS muestra el plato que
         corresponde con eso, sin que nada se mueva despues de cargar.
         El sitio es estatico: el build no sabe que dia va a ser cuando
         alguien entre, asi que esto no se puede resolver antes.
    -->
    <script is:inline define:vars={{ hoyDatos }}>
      (function () {
        var raiz = document.documentElement;
        raiz.classList.remove('no-js');
        raiz.classList.add('js');
        try {
          var d = JSON.parse(hoyDatos);
          var dia = new Intl.DateTimeFormat('es-AR', { timeZone: d.zona, weekday: 'long' })
            .format(new Date())
            .normalize('NFD')
            .replace(/[̀-ͯ]/g, '')
            .toLowerCase();
          raiz.dataset.hoy = dia;
          raiz.dataset.hoyConMenu = String(d.conMenu.indexOf(dia) >= 0);
          raiz.dataset.hoyCerrado = String(d.cerrados.indexOf(dia) >= 0);
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="min-h-dvh">
    <a
      href="#contenido"
      class="btn btn-ladrillo sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-5 focus:py-3"
      >Saltar al contenido</a
    >

    <AvisoCarga />
    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />

    {conCarrito && <Carrito />}
  </body>
</html>
